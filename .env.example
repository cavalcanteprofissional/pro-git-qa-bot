# =============================================================================
# Git Q&A Bot — Exemplo de Configuração (commitável, sem segredos)
# =============================================================================
# Copie este arquivo para .env.local e preencha com seus valores reais.
# python-dotenv carrega .env.local automaticamente na Streamlit UI.

# --- Provedor LLM ---
# Escolha UM provedor e descomente/configure a chave correspondente.
# Opção A — Gemini Free Tier (default, recomendado)
#   Obter chave: https://aistudio.google.com/apikey
# GEMINI_API_KEY=AIza_sua_chave_aqui

# Opção B — OpenAI (crédito grátis $5, expira 1 ano)
#   Obter chave: https://platform.openai.com/api-keys
# OPENAI_API_KEY=sk-sua-chave-aqui

# Opção C — Anthropic (crédito grátis $5, expira 14d)
#   Obter chave: https://console.anthropic.com/
# ANTHROPIC_API_KEY=sk-ant-sua-chave-aqui

# Opção D — Groq (free tier, 6.000 req/min, usado para RAGAS judge)
#   Obter chave: https://console.groq.com/keys
# GROQ_API_KEY=gsk_sua-chave-aqui

# --- Modelos (descomente conforme o provedor escolhido) ---
# Gemini (default)
LLM_MODEL=gemini-2.5-flash-lite
CHEAP_MODEL=gemini-2.5-flash-lite
PREMIUM_MODEL=gemini-2.5-pro
EMBED_MODEL=BAAI/bge-small-en-v1.5

# OpenAI
# LLM_MODEL=gpt-4o-mini
# EMBED_MODEL=text-embedding-3-small

# Anthropic
# LLM_MODEL=claude-haiku-4.5

# --- Observabilidade (opcional) ---
# Langfuse — dashboard de traces, latência e custo
# Criar conta: https://langfuse.com
# LANGFUSE_PUBLIC_KEY=pk-lf-seu-public-key
# LANGFUSE_SECRET_KEY=sk-lf-seu-secret-key
# LANGFUSE_BASE_URL=https://us.cloud.langfuse.com
